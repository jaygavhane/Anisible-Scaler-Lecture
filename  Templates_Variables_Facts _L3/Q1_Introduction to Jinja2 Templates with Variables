Create the workspace directory:
mkdir -p /home/user/workspace
cd /home/user/workspace
Create the inventory file:
[web]
server1 ansible_host=server1 ansible_user=server1_admin ansible_password=server1_admin@123! ansible_become_password=server1_admin@123!
Create the Jinja2 template nginx.conf.j2:
server {
    listen {{ nginx_port }};
    server_name {{ server_name }};

    location / {
        root {{ web_root }};
        index index.html;
    }
}
Create the playbook nginx-template.yml:
- hosts: web
  become: true
  gather_facts: false

  vars:
    nginx_port: 80
    server_name: localhost
    web_root: /var/www/html

  tasks:
    - name: Install nginx package
      package:
        name: nginx
        state: present

    - name: Deploy nginx configuration using template
      template:
        src: nginx.conf.j2
        dest: /etc/nginx/nginx.conf

Run a syntax check:
ansible-playbook -i inventory.ini nginx-template.yml --syntax-check

Execute the playbook:
ansible-playbook -i inventory.ini nginx-template.yml

Verify the rendered file on server1:
ansible -i inventory.ini web -m shell -a "cat /etc/nginx/nginx.conf"